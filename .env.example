# ==============================================================================
# Verifiable Support Agent v2 — Environment Configuration Template
# ==============================================================================
# NOTE: Never commit your actual .env file or real secrets to version control.
# Copy this file to .env locally and fill in your values.

# GCP Project & Authentication
PROJECT_ID=your-gcp-project-id
REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=

# Vertex AI Model Configuration
GEMINI_MODEL=gemini-1.5-flash-002
TEXT_EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768

# PostgreSQL + pgvector Database Configuration
# (For local dev via docker-compose: localhost:5432)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=support_agent_db
DB_USER=postgres
DB_PASSWORD=your_secure_password
INSTANCE_CONNECTION_NAME=your-gcp-project:region:instance-name

# Evaluation & Tracing
OPENTELEMETRY_EXPORTER=console  # 'console' for local dev, 'cloud_trace' for GCP
LOG_LEVEL=INFO
APP_ENV=development  # development, staging, production
